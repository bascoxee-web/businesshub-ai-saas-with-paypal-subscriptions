# Supabase: Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# The "anon" or "publishable" key (safe for the browser; row-level security protects the data)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# Where the app lives (used for invoice links and sign-up email links)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# AI Assistant (server only, never expose to the browser)
GEMINI_API_KEY=
GEMINI_MODEL=
# Optional: override the model
# Set GEMINI_MODEL to an available function-calling model in your AI Studio project.

# PayPal invoice payments (server only). Create a REST app at developer.paypal.com.
# Leave these out to hide the Pay button; invoices can still be marked paid by hand.
PAYPAL_ENV=sandbox            # use "live" once you've tested in the sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# After adding the webhook in the PayPal dashboard (URL: <site>/api/paypal/webhook), paste its id here
PAYPAL_WEBHOOK_ID=
# Supabase service-role key. Server only. Used for verified payment settlement and subscription reconciliation only.
SUPABASE_SERVICE_ROLE_KEY=

# Server-only live website retrieval
FIRECRAWL_API_KEY=

# New sales gate: disabled (default), sandbox, or live. Must match PAYPAL_ENV.
SUBSCRIPTIONS_ENABLED=disabled
PAYPAL_PLAN_STARTER=
PAYPAL_PLAN_GROWTH=
PAYPAL_PLAN_BUSINESS=
PAYPAL_PLAN_AI_BUILDER=

# New billing lifecycle (database/proposals/billing-lifecycle.sql).
# Prices are integer cents, e.g. 1500 means 15.00; set only after the owner approves pricing.
PAYPAL_BILLING_CURRENCY=USD
PAYPAL_STARTER_MONTHLY_CENTS=
PAYPAL_GROWTH_MONTHLY_CENTS=
PAYPAL_BUSINESS_MONTHLY_CENTS=
PAYPAL_AI_BUILDER_MONTHLY_CENTS=1500
BILLING_SUPPORT_EMAIL=
# Strong random secret for authenticated daily reconciliation. Never NEXT_PUBLIC_.
CRON_SECRET=
# Live checkout additionally requires production Vercel environment and successful sandbox/production verification.
# Do not set to yes before the release checks in BILLING.md pass.
PAYPAL_LIVE_VERIFIED=no

# Release switches (disabled by default; redeploy after changing hosted values)
ALLOW_INDEXING=false
PAID_PLANS_ENABLED=false
PAYPAL_PLAN_PRO=
PAYPAL_PLAN_AGENCY=
PAYPAL_PRO_MONTHLY_CENTS=3500
PAYPAL_AGENCY_MONTHLY_CENTS=7900

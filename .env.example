# Supabase: Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# The "anon" or "publishable" key (safe for the browser; row-level security protects the data)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# Where the app lives (used for invoice links and sign-up email links)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# AI Assistant (server only, never expose to the browser)
GEMINI_API_KEY=
GEMINI_MODEL=
# Optional: override the model
# Set GEMINI_MODEL to an available function-calling model in your AI Studio project.

# PayPal invoice payments (server only). Create a REST app at developer.paypal.com.
# Leave these out to hide the Pay button; invoices can still be marked paid by hand.
PAYPAL_ENV=sandbox            # use "live" once you've tested in the sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# After adding the webhook in the PayPal dashboard (URL: <site>/api/paypal/webhook), paste its id here
PAYPAL_WEBHOOK_ID=
# Supabase service-role key. Server only. Used for verified invoice settlement and sandbox subscription binding only.
SUPABASE_SERVICE_ROLE_KEY=

# Server-only live website retrieval
FIRECRAWL_API_KEY=

# Subscription testing only. Live subscription charges are intentionally disabled in code.
SUBSCRIPTIONS_ENABLED=sandbox
PAYPAL_PLAN_STARTER=
PAYPAL_PLAN_GROWTH=
PAYPAL_PLAN_BUSINESS=
